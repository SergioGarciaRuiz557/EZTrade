# Backend
DB_URL=jdbc:mysql://localhost:3306/EZTrade?createDatabaseIfNotExist=true
DB_USERNAME=eztrade_user
DB_PASSWORD=change-me

ALPHA_VANTAGE_API_KEY=replace-with-alpha-vantage-key
ALPHA_VANTAGE_MIN_INTERVAL_MS=1100
MARKET_CACHE_TTL_SECONDS=30

# Base64-encoded HMAC secret with enough entropy for JWT signing.
JWT_SECRET=replace-with-base64-encoded-secret
JWT_TOKEN_EXPIRATION_MS=86400000
JWT_REFRESH_WINDOW_MS=604800000

APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8088
NEXT_PUBLIC_WS_URL=ws://localhost:8088/ws
