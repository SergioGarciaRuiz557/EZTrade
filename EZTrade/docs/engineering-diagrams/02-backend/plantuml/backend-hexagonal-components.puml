@startuml
!include ../../common/eztrade-style.puml

title EZTrade Backend - Hexagonal Component Pattern

package "Input adapters" as InLayer {
  component "REST controllers\nAuth/User/Market/Trading/\nWallet/Portfolio" as RestIn EZ_FRONTEND
  component "Spring event listeners\nwallet, portfolio, notifications" as EventIn EZ_FRONTEND
  component "STOMP input authentication\nStompAuthChannelInterceptor" as StompIn EZ_FRONTEND
}

package "Application layer" as AppLayer EZ_BACKEND {
  component "Input ports\nuse case interfaces" as PortsIn
  component "Application services\nAuthService, UserService,\nGetPriceService, TradingService,\nWalletService, PortfolioService,\nNotificationService" as AppServices
  component "Output ports\nrepositories, event publisher,\nmarket provider, notification channels" as PortsOut
}

package "Domain layer" as DomainLayer EZ_DOMAIN {
  component "Aggregates\nTradeOrder, WalletAccount,\nPosition, User" as Aggregates
  component "Value objects and records\nMoney, Quantity, Symbol,\nWalletTransaction, events" as ValueObjects
  component "Domain exceptions\nTrading/Wallet/Portfolio/Market/User" as Exceptions
}

package "Output adapters" as OutLayer {
  database "Spring Data JPA\nrepository adapters + entities" as Jpa EZ_DB
  component "AlphaVantageAPI\nRestClient adapter" as AlphaAdapter EZ_EXTERNAL
  component "Cached provider with Caffeine\n@Primary decorator" as CacheAdapter
  component "Spring Event publishers\nApplicationEventPublisher" as SpringPublisher
  component "Notification channels\nWebSocket, inbox,\nlogging email/push" as NotificationAdapters
}

RestIn --> PortsIn
EventIn --> PortsIn
StompIn --> AppServices : authenticates STOMP frames
PortsIn --> AppServices
AppServices --> Aggregates
AppServices --> ValueObjects
AppServices --> Exceptions
AppServices --> PortsOut
PortsOut <|.. Jpa
PortsOut <|.. AlphaAdapter
PortsOut <|.. CacheAdapter
PortsOut <|.. SpringPublisher
PortsOut <|.. NotificationAdapters
CacheAdapter --> AlphaAdapter

note right of AppServices
Each business module follows this shape,
although security and notifications are more
cross-cutting than pure domain modules.
end note

@enduml
