@startuml
!include ../../common/eztrade-style.puml

title EZTrade - Arquitectura de contenedores de alto nivel

node "Cliente" as Client {
  actor "Navegador" as Browser
}

node "Tiempo de ejecucion frontend\nNext.js 15 / React 19" as NextRuntime EZ_FRONTEND {
  component "App Router\napp/(auth), app/(dashboard), app/page.tsx" as AppRouter
  component "AuthProvider\nlocalStorage + JWT UX decode" as AuthProvider
  component "Clientes API por feature\nfeatures/*/api.ts" as FeatureClients
  component "NotificationsWebSocket\n@stomp/stompjs" as WsClient
}

node "Tiempo de ejecucion backend\nSpring Boot 4.0.1" as SpringRuntime EZ_BACKEND {
  component "Cadena de filtros de seguridad\nJWT + UserAccessFilter + CORS" as Security
  component "Controladores REST\nAuth, User, Market, Trading, Wallet, Portfolio" as Controllers
  component "Modulos Spring Modulith\nuser/security/market/trading/wallet/portfolio/notifications" as Modules
  component "Eventos Spring\nadaptadores DomainEventPublisherPort" as Events
  component "Cache Caffeine\nmarketPrice, overview, dailyCandles" as Cache
  component "STOMP broker\n/topic, /queue, /user" as Broker
}

database "MySQL\njdbc:mysql://localhost:3306/EZTrade" as Db EZ_DB
component "Alpha Vantage API" as Alpha EZ_EXTERNAL

Browser --> AppRouter : HTTP pages
AppRouter --> AuthProvider : estado de sesion
AppRouter --> FeatureClients : REST operations
FeatureClients --> Security : fetchWithAuth\nAuthorization Bearer
WsClient --> Broker : brokerURL /ws\nAuthorization header
Security --> Controllers : peticion autenticada
Controllers --> Modules : puertos de entrada / casos de uso
Modules --> Events : publish/listen eventos de dominio
Modules --> Db : repositories + JPA entities
Modules --> Cache : cached market provider
Cache --> Alpha : RestClient HTTPS
Broker --> WsClient : user notifications

note right of Db
No se han encontrado scripts Flyway/Liquibase.
El esquema se infiere desde entidades JPA
y hibernate ddl-auto=update.
end note

@enduml
