@startuml
!include ../../common/eztrade-style.puml

title EZTrade - High-Level Container Architecture

node "Client" as Client {
  actor "Browser" as Browser
}

node "Frontend runtime\nNext.js 15 / React 19" as NextRuntime EZ_FRONTEND {
  component "App Router\napp/(auth), app/(dashboard), app/page.tsx" as AppRouter
  component "AuthProvider\nlocalStorage + JWT UX decode" as AuthProvider
  component "Feature API clients\nfeatures/*/api.ts" as FeatureClients
  component "NotificationsWebSocket\n@stomp/stompjs" as WsClient
}

node "Backend runtime\nSpring Boot 4.0.1" as SpringRuntime EZ_BACKEND {
  component "Security filter chain\nJWT + UserAccessFilter + CORS" as Security
  component "REST controllers\nAuth, User, Market, Trading, Wallet, Portfolio" as Controllers
  component "Spring Modulith modules\nuser/security/market/trading/wallet/portfolio/notifications" as Modules
  component "Spring Events\nDomainEventPublisherPort adapters" as Events
  component "Caffeine cache\nmarketPrice, overview, dailyCandles" as Cache
  component "STOMP broker\n/topic, /queue, /user" as Broker
}

database "MySQL\njdbc:mysql://db:3306/EZTrade in Docker\nlocalhost:3306 from host" as Db EZ_DB
component "Alpha Vantage API" as Alpha EZ_EXTERNAL
component "Docker Compose\nservices: db, backend, frontend" as Compose EZ_DEVOPS

Browser --> AppRouter : HTTP pages
AppRouter --> AuthProvider : session state
AppRouter --> FeatureClients : REST operations
FeatureClients --> Security : fetchWithAuth\nAuthorization Bearer
WsClient --> Broker : brokerURL /ws\nAuthorization header
Security --> Controllers : authenticated request
Controllers --> Modules : input ports / use cases
Modules --> Events : publish/listen domain events
Modules --> Db : repositories + JPA entities
Modules --> Cache : cached market provider
Cache --> Alpha : RestClient HTTPS
Broker --> WsClient : user notifications
Compose ..> NextRuntime : builds frontend Dockerfile
Compose ..> SpringRuntime : builds backend Dockerfile
Compose ..> Db : starts mysql:8.4

note right of Db
No Flyway/Liquibase scripts were found.
The schema is inferred from JPA entities
and hibernate ddl-auto=update.
end note

@enduml
