@startuml
!include ../../common/eztrade-style.puml

title EZTrade - Frontend-Backend-Database Architecture

package "Frontend Next.js" as FE EZ_FRONTEND {
  component "Public home\napp/page.tsx" as Home
  component "Authentication routes\n/login, /register" as AuthRoutes
  component "Protected dashboard routes\n/dashboard, /trading, /wallet, /market" as DashRoutes
  component "AuthProvider\nlib/auth-context.tsx" as AuthCtx
  component "API client\nlib/api-client.ts + features/*/api.ts" as ApiClient
  component "SWR + local component state" as State
  component "STOMP client\nNotificationsWebSocket" as StompClient
}

package "Backend Spring Boot" as BE EZ_BACKEND {
  component "Security layer\nJwtAuthFilter, UserAccessFilter,\nAuthenticationConfig" as Sec
  component "REST input adapters\ncontrollers" as Rest
  component "Application services\nuse cases" as Services
  component "Domain model\naggregates + events" as Domain EZ_DOMAIN
  component "Output adapters\nJPA, AlphaVantage, WebSocket, Inbox" as Out
  component "Spring Events\nsynchronous + asynchronous listeners" as EventBus
  component "STOMP broker\n/ws, /user/queue/notifications" as WsBroker
}

database "MySQL schema\ninferred by JPA" as DB EZ_DB
component "Alpha Vantage" as Alpha EZ_EXTERNAL
component "Docker Compose\nlocal db/backend/frontend" as Compose EZ_DEVOPS

Home --> ApiClient : market data\noptional buy redirect
AuthRoutes --> AuthCtx : login/register
DashRoutes --> AuthCtx : route guard
DashRoutes --> State : SWR reads + local forms
State --> ApiClient
ApiClient --> Sec : REST JSON\nJWT Bearer
Sec --> Rest
Rest --> Services
Services --> Domain
Services --> Out
Out --> DB : Spring Data JPA
Out --> Alpha : RestClient
Domain --> EventBus : domain events
EventBus --> Services : listeners invoke use cases
EventBus --> WsBroker : notification adapter
StompClient --> WsBroker : subscribe
WsBroker --> StompClient : private messages
Compose ..> FE
Compose ..> BE
Compose ..> DB

note bottom
REST routes and WebSocket destinations come from controllers,
WebSocketConfig, and frontend feature clients. The table structure is inferred
from JPA entities, not from migration files.
end note

@enduml
