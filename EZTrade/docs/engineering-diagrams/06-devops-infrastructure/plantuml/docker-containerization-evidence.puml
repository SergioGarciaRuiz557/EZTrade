@startuml
!include ../../common/eztrade-style.puml

title EZTrade DevOps - Docker Containerization Evidence

package "Application runtime artifacts found" as AppArtifacts EZ_DEVOPS {
  component "docker-compose.yml\nservices: db, backend, frontend" as ComposeFound
  component "backend/Dockerfile\nEclipse Temurin 21 + Maven wrapper" as BackendDockerfile
  component "frontend/Dockerfile\nNode 22 Alpine + npm ci" as FrontendDockerfile
  component ".env.example\nlocal ports and service variables" as EnvExample
}

package "Local Compose runtime" as Runtime EZ_BACKEND {
  database "db\nmysql:8.4\nvolume eztrade_mysql_data" as Db
  component "backend\nspring-boot:run\nport 8088" as Backend
  component "frontend\nnpm run dev\nport 3000" as Frontend
}

package "Not declared in repository" as Missing EZ_RISK {
  component "Production IaC\nKubernetes / Helm / Terraform" as IaCMissing
  component "Reverse proxy config\nNginx / Traefik" as ProxyMissing
  component "CI image publication\nregistry push job" as RegistryMissing
}

ComposeFound --> Db
ComposeFound --> Backend
ComposeFound --> Frontend
BackendDockerfile --> Backend
FrontendDockerfile --> Frontend
EnvExample --> ComposeFound
Backend --> Db : JDBC service name db
Frontend --> Backend : browser calls localhost:8088

note right of AppArtifacts
The repository now defines local application containers.
The evidence is scoped to development runtime, not production deployment.
end note

note bottom
Docker is also used by the documentation scripts to render PlantUML diagrams,
but that tooling is independent from the application runtime containers.
end note

@enduml
