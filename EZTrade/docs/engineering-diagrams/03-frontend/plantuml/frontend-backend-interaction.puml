@startuml
!include ../../common/eztrade-style.puml

title EZTrade Frontend - Feature APIs to Backend Endpoints

package "Frontend feature clients" as FE EZ_FRONTEND {
  component "authApi" as AuthApi
  component "marketApi" as MarketApi
  component "tradingApi" as TradingApi
  component "walletApi" as WalletApi
  component "portfolioApi" as PortfolioApi
  component "fetchWithAuth\nhandleResponse" as FetchWithAuth
}

package "Backend REST controllers" as BE EZ_BACKEND {
  component "AuthController\nPOST /auth/login" as AuthController
  component "UserController\nPOST /api/user/register\nGET /api/user" as UserController
  component "MarketController\nGET /api/v1/market/*" as MarketController
  component "TradingController\n/api/v1/trading/orders" as TradingController
  component "TradingMarketplaceController\n/api/v1/trading/market/buy\n/api/v1/trading/offers" as MarketplaceController
  component "WalletController\n/api/v1/wallet/*" as WalletController
  component "PortfolioController\nGET /api/portfolio" as PortfolioController
}

AuthApi --> AuthController : login
AuthApi --> UserController : register, getUser
MarketApi --> MarketController : getPrice, search,\ngetOverview, getDailyCandles
TradingApi --> TradingController : get/place/execute/cancel orders
TradingApi --> MarketplaceController : buyFromMarket,\nplaceSellOffer,\ngetSellOffers, buySellOffer
WalletApi --> WalletController : balance, deposit,\nwithdraw, transfer,\ntransactions
PortfolioApi --> PortfolioController : getPortfolio

AuthApi --> FetchWithAuth : protected getUser
MarketApi --> FetchWithAuth
TradingApi --> FetchWithAuth
WalletApi --> FetchWithAuth
PortfolioApi --> FetchWithAuth

note bottom
Evidence: frontend/features/*/api.ts and backend controller annotations.
The frontend API base is NEXT_PUBLIC_API_URL, defaulting to http://localhost:8088.
end note

@enduml
