@startuml
!include ../../common/eztrade-style.puml

title EZTrade Operations - External Dependencies and Integrations

package "Backend dependencies and integrations" as Backend EZ_BACKEND {
  component "Spring Boot 4.0.1" as SpringBoot
  component "Spring Modulith 2.0.1" as Modulith
  component "Spring Data JPA + MySQL connector" as JpaMysql
  component "Spring Security + JJWT" as SecurityJwt
  component "Spring WebSocket/STOMP" as WebSocket
  component "Caffeine cache" as Caffeine
  component "Alpha Vantage API\nexternal market data" as Alpha EZ_EXTERNAL
}

package "Frontend dependencies" as Frontend EZ_FRONTEND {
  component "Next.js 15 + React 19" as NextReact
  component "SWR" as Swr
  component "@stomp/stompjs" as StompJs
  component "Radix UI + lucide-react" as UiDeps
  component "Recharts" as Recharts
  component "Tailwind CSS" as Tailwind
}

package "Runtime and CI tooling" as Tooling EZ_DEVOPS {
  component "Docker Compose" as DockerCompose
  component "backend Dockerfile\nEclipse Temurin 21" as BackendDocker
  component "frontend Dockerfile\nNode 22 Alpine" as FrontendDocker
  component "GitHub Actions" as GithubActions
}

database "MySQL local/runtime" as MySQL EZ_DB

JpaMysql --> MySQL
Alpha --> SpringBoot : RestClient calls from AlphaVantageAPI
WebSocket --> StompJs : STOMP protocol
GithubActions --> SpringBoot : Maven verify
DockerCompose --> BackendDocker
DockerCompose --> FrontendDocker
DockerCompose --> MySQL : mysql:8.4 service
NextReact --> Swr : data fetching
NextReact --> UiDeps : UI primitives/icons
NextReact --> Recharts : charts
NextReact --> Tailwind : styling
Caffeine --> Alpha : cache external calls

note bottom
Evidence: backend/pom.xml, frontend/package.json, docker-compose.yml,
backend/Dockerfile, frontend/Dockerfile, AlphaVantageAPI.java,
CachedMarketDataProvider.java, notifications-ws.tsx, and the GitHub Actions workflow.
end note

@enduml
