@startuml
!include ../../common/eztrade-style.puml

title EZTrade Operations - Dependencias externas e integraciones

package "Dependencias e integraciones backend" as Backend EZ_BACKEND {
  component "Spring Boot 4.0.1" as SpringBoot
  component "Spring Modulith 2.0.1" as Modulith
  component "Spring Data JPA + MySQL connector" as JpaMysql
  component "Spring Security + JJWT" as SecurityJwt
  component "Spring WebSocket/STOMP" as WebSocket
  component "Caffeine cache" as Caffeine
  component "Alpha Vantage API\ndatos de mercado externos" as Alpha EZ_EXTERNAL
}

package "Dependencias frontend" as Frontend EZ_FRONTEND {
  component "Next.js 15 + React 19" as NextReact
  component "SWR" as Swr
  component "@stomp/stompjs" as StompJs
  component "Radix UI + lucide-react" as UiDeps
  component "Recharts" as Recharts
  component "Tailwind CSS" as Tailwind
}

database "MySQL local/ejecucion" as MySQL EZ_DB
component "GitHub Actions" as GithubActions EZ_DEVOPS

JpaMysql --> MySQL
Alpha --> SpringBoot : llamadas RestClient desde AlphaVantageAPI
WebSocket --> StompJs : STOMP protocol
GithubActions --> SpringBoot : Maven verify
NextReact --> Swr : data fetching
NextReact --> UiDeps : UI primitives/icons
NextReact --> Recharts : charts
NextReact --> Tailwind : styling
Caffeine --> Alpha : cache external calls

note bottom
Evidencia: backend/pom.xml, frontend/package.json, AlphaVantageAPI.java,
CachedMarketDataProvider.java, notifications-ws.tsx y flujo de trabajo de GitHub Actions.
end note

@enduml
