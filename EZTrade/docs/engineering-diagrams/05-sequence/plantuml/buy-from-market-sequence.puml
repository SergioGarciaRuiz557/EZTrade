@startuml
!include ../../common/eztrade-style.puml

title EZTrade Sequence - Direct Market Buy End-to-End
autonumber

actor "Authenticated user" as User
participant "TradingPage\nBuyOrderForm" as TradingPage
participant "tradingApi" as TradingApi
participant "TradingMarketplaceController\nPOST /api/v1/trading/market/buy" as Controller
participant "TradingService\nbuy()" as TradingService
participant "MarketPriceLookupPort" as MarketPort
participant "CachedMarketDataProvider\nAlphaVantageAPI" as MarketProvider
database "trade_order" as TradeOrderDb
participant "Spring Events" as Events
participant "Wallet TradingEventsListener" as WalletListener
participant "WalletService" as WalletService
database "wallet_account\nwallet_ledger_entry" as WalletDb
participant "Portfolio listeners" as PortfolioListeners
participant "PortfolioService" as PortfolioService
database "portfolio_position\nportfolio_cash_projection" as PortfolioDb
participant "Notifications listener/service" as Notifications

User -> TradingPage : sends symbol + quantity
TradingPage -> TradingApi : buyFromMarket({symbol, quantity})
TradingApi -> Controller : POST /api/v1/trading/market/buy\nJWT Bearer
Controller -> TradingService : buy(BuyFromMarketCommand)
TradingService -> MarketPort : currentPrice(symbol)
MarketPort -> MarketProvider : getMarketPrice(symbol)
MarketProvider --> TradingService : current price

TradingService -> TradingService : place BUY order\nstatus=PENDING
TradingService -> TradeOrderDb : save order
TradeOrderDb --> TradingService : order with id
TradingService -> Events : publish OrderPlacedEvent
Events -> WalletListener : synchronous @EventListener
WalletListener -> WalletService : handle(OrderPlacedEvent)
WalletService -> WalletDb : lock/open wallet\nreserve amount\nwrite RESERVE ledger
WalletService -> Events : FundsReservedEvent\nAvailableCashUpdatedEvent

TradingService -> TradingService : execute(orderId)
TradingService -> TradeOrderDb : load + save EXECUTED
TradingService -> Events : publish OrderExecutionRequestEvent
Events -> WalletListener : synchronous @EventListener
WalletListener -> WalletService : handle(OrderExecutionRequestEvent)
WalletService -> WalletDb : settle reserved debit\nwrite SETTLEMENT_DEBIT ledger
WalletService -> Events : OrderExecutedEvent\nAvailableCashUpdatedEvent\nFundsSettledEvent

Events -> PortfolioListeners : OrderExecutedEvent\nAvailableCashUpdatedEvent
PortfolioListeners -> PortfolioService : update position/cash projection
PortfolioService -> PortfolioDb : save position\nsave cash projection
PortfolioService -> Events : PortfolioValuationUpdatedEvent
Events -> Notifications : after commit / async notification events
Notifications --> User : WebSocket toast + inbox/logging channels

TradingService --> Controller : executed TradeOrder
Controller --> TradingApi : 201 TradeOrderResponse
TradingApi --> TradingPage : refresh SWR caches\norders/portfolio/wallet

note bottom
Evidence: TradingMarketplaceController.buyFromMarket, TradingService.buy/place/execute,
WalletService.handle(OrderPlacedEvent/OrderExecutionRequestEvent),
PortfolioService.handle(OrderExecutedEvent/AvailableCashUpdatedEvent),
DomainEventsListener, and frontend tradingApi.
end note

@enduml
