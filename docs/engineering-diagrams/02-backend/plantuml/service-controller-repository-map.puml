@startuml
!include ../../common/eztrade-style.puml

title EZTrade Backend - Controllers, Services, and Repositories

package "REST controllers" as Controllers EZ_FRONTEND {
  component "AuthController\n/auth/login" as AuthController
  component "UserController\n/api/user" as UserController
  component "MarketController\n/api/v1/market" as MarketController
  component "TradingController\n/api/v1/trading/orders" as TradingController
  component "TradingMarketplaceController\n/api/v1/trading" as MarketplaceController
  component "WalletController\n/api/v1/wallet" as WalletController
  component "PortfolioController\n/api/portfolio" as PortfolioController
}

package "Application services" as Services EZ_BACKEND {
  component "AuthService" as AuthService
  component "UserService" as UserService
  component "GetPrice/Search/Overview/Candles services" as MarketServices
  component "TradingService" as TradingService
  component "WalletService" as WalletService
  component "PortfolioService" as PortfolioService
  component "NotificationService" as NotificationService
}

package "Repository/provider adapters" as Adapters EZ_DB {
  component "UserRepositoryAdapter\nJpaUserRepository" as UserRepo
  component "TradeOrderRepositoryAdapter\nSpringDataTradeOrderRepository" as TradingRepo
  component "WalletAccountRepositoryAdapter\nWalletTransactionRepositoryAdapter" as WalletRepo
  component "PositionRepositoryAdapter\nCashProjectionRepositoryAdapter" as PortfolioRepo
  component "CachedMarketDataProvider\nAlphaVantageAPI" as MarketProvider
  component "InboxNotificationAdapter\nSpringDataInboxNotificationRepository" as InboxRepo
}

AuthController --> AuthService
UserController --> UserService
MarketController --> MarketServices
TradingController --> TradingService
MarketplaceController --> TradingService
WalletController --> WalletService
PortfolioController --> PortfolioService

AuthService --> UserRepo
UserService --> UserRepo
MarketServices --> MarketProvider
TradingService --> TradingRepo
TradingService --> MarketProvider : MarketPriceLookupPort
WalletService --> WalletRepo
PortfolioService --> PortfolioRepo
PortfolioService --> MarketProvider : valuation
NotificationService --> InboxRepo

note bottom
Evidence: controller constructors, service constructors, in/out ports,
repository adapters, and Spring Data repository interfaces.
end note

@enduml
