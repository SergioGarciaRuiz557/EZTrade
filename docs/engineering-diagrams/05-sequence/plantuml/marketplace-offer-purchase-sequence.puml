@startuml
!include ../../common/eztrade-style.puml

title EZTrade Sequence - SELL Offer Purchase in Marketplace
autonumber

actor "Buyer" as Buyer
participant "TradingPage\nMarketplaceOffers" as Page
participant "tradingApi" as Api
participant "TradingMarketplaceController\nPOST /api/v1/trading/offers/{offerId}/buy" as Controller
participant "TradingService\nbuyOffer()" as TradingService
participant "TradeOrderRepositoryPort" as Repo
database "trade_order" as TradeOrderDb
participant "MarketPriceLookupPort" as MarketPort
participant "Spring Events" as Events
participant "WalletService\nthrough listener" as Wallet
participant "PortfolioService\nthrough listener" as Portfolio

Buyer -> Page : clicks buy offer
Page -> Api : buySellOffer(offerId)
Api -> Controller : POST /api/v1/trading/offers/{offerId}/buy\nJWT Bearer
Controller -> TradingService : buyOffer(BuySellOfferCommand)
TradingService -> Repo : findByIdForUpdate(offerId)
Repo -> TradeOrderDb : PESSIMISTIC_WRITE lock
TradeOrderDb --> Repo : SELL offer
Repo --> TradingService : TradeOrder
TradingService -> TradingService : validate seller != buyer\nstatus=PENDING\nside=SELL
TradingService -> MarketPort : currentPrice(symbol)
MarketPort --> TradingService : current market price
TradingService -> Repo : finds pending SELL offers\nand executed orders
Repo --> TradingService : seller coverage data

TradingService -> TradingService : place BUY order for buyer\nsame symbol, quantity, price
TradingService -> Repo : save buyer BUY PENDING
Repo -> TradeOrderDb : insert
TradingService -> Events : OrderPlacedEvent(BUY)
Events -> Wallet : reserve buyer funds

TradingService -> TradingService : execute buyer BUY
TradingService -> Repo : save BUY EXECUTED
TradingService -> Events : OrderExecutionRequestEvent(BUY)
Events -> Wallet : settle buyer debit\npublish OrderExecutedEvent
Events -> Portfolio : increase/open buyer position

TradingService -> TradingService : execute seller SELL offer
TradingService -> Repo : save SELL EXECUTED
TradingService -> Events : OrderExecutionRequestEvent(SELL)
Events -> Wallet : credit seller wallet\npublish OrderExecutedEvent
Events -> Portfolio : reduce/close seller position

TradingService --> Controller : MarketplaceTradeResult\nbuyer order + seller order
Controller --> Api : MarketplaceTradeResponse
Api --> Page : mutate offers/orders/portfolio/wallet

note bottom
Evidence: TradingMarketplaceController.buyOffer, TradingService.buyOffer,
SpringDataTradeOrderRepository.findByIdForUpdate, and marketplace endpoints in frontend/features/trading/api.ts.
The pessimistic lock is explicitly declared in the repository method.
end note

@enduml
