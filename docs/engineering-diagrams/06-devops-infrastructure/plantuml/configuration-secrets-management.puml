@startuml
!include ../../common/eztrade-style.puml

title EZTrade DevOps - Configuration and Secrets Flow

component ".env.example" as EnvExample EZ_DEVOPS
component "docker-compose.yml" as Compose EZ_DEVOPS
component "application.properties" as AppProps EZ_DEVOPS
component "Spring Boot environment" as SpringEnv EZ_BACKEND
component "Next.js public variables" as NextEnv EZ_FRONTEND

component "DB_URL\nDB_USERNAME\nDB_PASSWORD\nMYSQL_ROOT_PASSWORD" as DbSecrets EZ_RISK
component "ALPHA_VANTAGE_API_KEY\nALPHA_VANTAGE_MIN_INTERVAL_MS" as AlphaSecrets EZ_RISK
component "JWT_SECRET\nJWT token/refresh windows" as JwtSecrets EZ_RISK
component "APP_CORS_ALLOWED_ORIGINS" as CorsEnv
component "NEXT_PUBLIC_API_URL\nNEXT_PUBLIC_WS_URL" as NextPublic
component "BACKEND_PORT\nFRONTEND_PORT\nDB_PORT" as ComposePorts

database "MySQL datasource" as Datasource EZ_DB
component "AlphaVantageAPI" as AlphaAdapter EZ_EXTERNAL
component "JwtService" as JwtService EZ_BACKEND
component "AuthenticationConfig\nCORS" as AuthConfig EZ_BACKEND
component "frontend api-client\nnotifications-ws" as FrontConfig EZ_FRONTEND

EnvExample --> DbSecrets
EnvExample --> AlphaSecrets
EnvExample --> JwtSecrets
EnvExample --> CorsEnv
EnvExample --> NextPublic
EnvExample --> ComposePorts
Compose --> DbSecrets : passes service env
Compose --> AlphaSecrets
Compose --> JwtSecrets
Compose --> CorsEnv
Compose --> NextPublic
Compose --> ComposePorts : port mappings
AppProps --> SpringEnv : property defaults + env placeholders
DbSecrets --> SpringEnv
AlphaSecrets --> SpringEnv
JwtSecrets --> SpringEnv
CorsEnv --> SpringEnv
NextPublic --> NextEnv

SpringEnv --> Datasource
SpringEnv --> AlphaAdapter
SpringEnv --> JwtService
SpringEnv --> AuthConfig
NextEnv --> FrontConfig

note bottom
Evidence: .env.example, docker-compose.yml, and backend/src/main/resources/application.properties.
The repository documents local environment variables, but there is no vault, sealed secrets,
documented GitHub environment secrets, or declared production secret manager.
Development defaults exist in application.properties and must not be treated as production secrets.
end note

@enduml
